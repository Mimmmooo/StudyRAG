# Copy to .env for local development. Never commit .env.
STUDYRAG_CHROMA_DIR=.chroma
STUDYRAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
STUDYRAG_CHUNK_SIZE=800
STUDYRAG_CHUNK_OVERLAP=120
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional free-tier keys; never add real keys to this file.
GEMINI_API_KEY=
GROQ_API_KEY=
\n# Optional retrieval distance cutoff (non-negative; tune using your notes)\nSTUDYRAG_MAX_DISTANCE=2.0\n